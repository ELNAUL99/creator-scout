YOUTUBE_API_KEY=

# LLM scoring. Mistral has a free tier and is OpenAI-compatible.
# Get a key at https://console.mistral.ai/ (API Keys). Just set MISTRAL_API_KEY:
MISTRAL_API_KEY=
# Optional overrides (defaults shown are used automatically for Mistral):
#   LLM_MODEL=mistral-small-latest   (or open-mistral-nemo, mistral-large-latest)
#   LLM_BASE_URL=https://api.mistral.ai/v1
LLM_MODEL=
LLM_BASE_URL=

# Alternative: OpenAI (used only if MISTRAL_API_KEY is unset)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Search-engine discovery of public TikTok/Instagram profiles (not platform scraping).
# Google Programmable Search: create a CSE that searches the whole web, then:
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
# Or Brave Search free tier:
BRAVE_SEARCH_API_KEY=

# Instagram Graph API Business Discovery (free). Meta developer app + IG business/creator
# linked to a Facebook Page. App admin can query public business/creator usernames in
# development mode. Hashtag Search is not assumed (needs Meta approval).
INSTAGRAM_GRAPH_TOKEN=
INSTAGRAM_BUSINESS_ID=

# Creator opt-in (official OAuth). Redirect URIs must match the developer console exactly.
# TikTok Login Kit: https://www.tiktok.com/v2/auth/authorize/
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3000/api/connect/tiktok/callback
# Instagram Login: https://www.instagram.com/oauth/authorize
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/connect/instagram/callback
APP_URL=http://localhost:3000

# Supabase (durable storage for opt-ins, shortlists, etc.).
# From Supabase dashboard → Project Settings → API. If unset, the app falls back
# to an ephemeral file store (not durable on Vercel).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Publishable/anon key for any future client-side use:
NEXT_PUBLIC_SUPABASE_ANON_KEY=
