{
  "manifest_version": 3,
  "name": "Scout Lens",
  "version": "0.1.0",
  "description": "Score the TikTok or Instagram profile you already have open. One profile at a time; no crawl.",
  "permissions": ["activeTab"],
  "host_permissions": ["http://localhost:3000/*", "https://www.tiktok.com/*", "https://www.instagram.com/*"],
  "action": {
    "default_title": "Score with Creator Scout"
  },
  "content_scripts": [
    {
      "matches": ["https://www.tiktok.com/@*", "https://www.instagram.com/*"],
      "js": ["content.js"]
    }
  ]
}
